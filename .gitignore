# Python virtual environment
.venv/
__pycache__/
*.pyc

# YOLOX upstream clone (fetched by scripts/setup_phase1.sh)
third_party/YOLOX/

# Large model weights (regenerated/downloaded by the setup script)
*.pth
*.pth.tar

# Input footage (user-provided; keep source video out of git)
data/*.mp4
data/*.avi
data/*.mov

# Raw pre-transcode video intermediates (replaced by the committed H.264 output)
outputs/*_mp4v.mp4

# RTSP camera snapshots (runtime output; may contain identifiable people)
outputs/rtsp/
outputs/rtsp_test/

# Fine-tuning data: frames/label exports/dataset images (privacy — customer
# faces — and large/derived). Keep scripts, guides, and classes.txt tracked.
finetune/images_to_label/
finetune/images_vehicles/
finetune/label_export/
finetune/label_export_auto/
finetune/dataset/train2017/
finetune/dataset/val2017/
finetune/dataset/annotations/

# YOLOX demo scratch output
YOLOX_outputs/

# Untracked heavy binaries — regenerable, kept out of git to keep the repo light.
# The ONNX model is rebuilt by scripts/setup_phase1.sh; annotated videos are
# regenerated by scripts/detect_video.py. Small preview .jpg stills stay tracked.
models/*.onnx
outputs/*.mp4

# ── Project skeleton — required exclusions ──────────────────────────────
# Secrets & local config
.env*
config.yaml
# Model weights / exports (regenerated by setup; never committed)
*.pth
*.onnx
# Local databases
*.db
# Runtime clip buffer
clips/
# Python
__pycache__/
venv/
# Test footage: keep the folder, ignore its (large/private) contents
/test_footage/*
!/test_footage/.gitkeep

# YOLOX upstream clone inside the agent (fetched by setup; regenerable)
agent/YOLOX/

# Generated demo/preview images under agent/ (regenerable; may contain footage
# frames of people). Agent CODE (*.py) stays tracked.
agent/*.jpg
agent/*.png
agent/label_preview/
